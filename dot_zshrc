# ============================== End aliases

#	============================== repository manager
# cd into selected repository
rr() {
	local selected_dir=$(ghq list | fzf --height=40% --layout=reverse) && cd "$(ghq root)/$selected_dir"
}

# Open selected repository in VSCode
crr() {
	local selected_dir=$(ghq list | fzf --height=40% --layout=reverse) &&
		echo "Open $(ghq root)/$selected_dir in VSCode"
	if [ -n "$selected_dir" ]; then
		code "$(ghq root)/$selected_dir"
	fi
}
#	============================== End repository manager

# ============================== Switch to selected local branch
gsw() {
	local selected_branch
	selected_branch=$(
		git branch \
			--sort=-committerdate \
			--format='%(refname:short)' |
		fzf --height=40% --layout=reverse
	) || return
	git switch "$selected_branch"
}

# Load ~/local/.zshrc if it exists
[[ -f ~/local/.zshrc ]] && source ~/local/.zshrc
