bindkey -e
setopt auto_cd
setopt auto_pushd
setopt hist_ignore_dups
setopt ignoreeof
setopt pushd_ignore_dups
setopt share_history
[[ -n $CLAUDECODE ]] || setopt noclobber

HISTFILE=~/.zsh_history
HISTORY_IGNORE="(l[sla]|lla|pwd|history|ps)"
HISTSIZE=10000
SAVEHIST=10000

export EDITOR="vim"
export PAGER=less
export LESS='-giXRMS'
export ABBR_QUIETER=1
export ABBR_SET_EXPANSION_CURSOR=1

# ============================== version manager
# https://mise.jdx.dev
eval "$(mise activate zsh)"
# search tools in https://mise-versions.jdx.dev
# ============================== End version manager

# ============================== Plugin manager
# https://sheldon.cli.rs
eval "$(sheldon source)"
# ============================== End Plugin manager

# ============================== fzf
# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)
# ============================== End fzf

# ============================== zoxide
eval "$(zoxide init zsh)"
# ============================== End zoxide

# ============================== aliases
# Claude Code の Bash は非対話 zsh で動き、ZLE 依存の abbr が展開されないため alias も定義する
ab() {
	abbr -S "$@"
	[[ -n $CLAUDECODE ]] && alias -- "${@[-1]}"
}
abbr -S -f ls='ls -F --color=auto'
abbr -S -f cp='cp -i'
abbr -S -f mv='mv -i'
abbr -S -f rm='rm -i'
abbr -S -f ln='ln -i'
ab -f mkdir='mkdir -p'
abbr -S -f grep='grep --color=auto'
ab -f sudo='sudo '
ab -f vi='vim'
abbr -S ll='ls -lF --color=auto'
abbr -S la='ls -AF --color=auto'
abbr -S lla='ls -lAF --color=auto'
abbr -S cpr='cp -ir'
ab sz='source ~/.zshrc'
ab vz='vim ~/.zshrc'
ab cz='code ~/.zshrc'
ab clz="code ~/local/.zshrc"
ab vlz="vim ~/local/.zshrc"
ab cdocs='code ~/Documents/vault'
# git
