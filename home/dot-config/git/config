[user]
	useConfigOnly = true
[init]
	defaultBranch = main
[color]
	ui = auto
[commit]
	template = ~/.config/git/.gitmessage.txt
	gpgsign = true
[core]
	excludesfile = ~/.config/git/ignore
[ghq]
	root = ~/src
[include]
	path = ~/.config/git/config.local
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
