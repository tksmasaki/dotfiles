#!/bin/bash
set -euo pipefail

self=$(realpath "$0")
real=""
while IFS= read -r candidate; do
  if [ "$(realpath "$candidate")" != "$self" ]; then
    real=$candidate
    break
  fi
done < <(type -ap playwright-cli)

if [ -z "$real" ]; then
  echo "playwright-cli: Homebrew の playwright-cli が見つかりません（brew install playwright-cli）" >&2
  exit 127
fi

subcommand() {
  while [ $# -gt 0 ]; do
    case $1 in
      -s | --session) shift 2 || return 0 ;;
      -*) shift ;;
      *)
        echo "$1"
        return 0
        ;;
    esac
  done
}

builtin_display_window_bounds() {
  /usr/bin/swift -e '
import AppKit
guard let primary = NSScreen.screens.first else { exit(0) }
for screen in NSScreen.screens {
  let id = screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as! UInt32
  guard CGDisplayIsBuiltin(id) != 0 else { continue }
  let f = screen.visibleFrame
  let top = primary.frame.height - (f.origin.y + f.height)
  print(Int(f.origin.x), Int(top), Int(f.width), Int(f.height))
}
' 2>/dev/null | head -1
}

if [ "$(subcommand "$@")" = open ] && [ -z "${PLAYWRIGHT_MCP_CONFIG:-}" ]; then
  read -r x y width height <<<"$(builtin_display_window_bounds)" || true
  if [ -n "${x:-}" ]; then
    config_dir="$HOME/.cache/playwright-cli"
    mkdir -p "$config_dir"
    cat >"$config_dir/window.json" <<JSON
{
  "browser": {
    "launchOptions": {
      "args": ["--window-position=${x},${y}", "--window-size=${width},${height}"]
    }
  }
}
JSON
    export PLAYWRIGHT_MCP_CONFIG="$config_dir/window.json"
  fi
fi

exec "$real" "$@"
