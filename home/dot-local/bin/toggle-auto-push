#!/usr/bin/env bash
# toggle-auto-push - Claude Code の push の確認省略（AGENT_AUTO_PUSH）を切り替える
#
# "1" のとき、~/.claude/hooks/confirm-remote-commands.sh は、push する範囲が自分の
# コミットだけで、PR に bot 以外の他者のレビューが無い git push を確認なしで通す。
# "1" 以外では、git push は必ず確認を求める。
#
# 状態は worktree ごとに分ける。書き込み先は git ディレクトリ直下の claude-env.json
# （メイン作業ツリーは <repo>/.git、worktree は <repo>/.git/worktrees/<名前>）。
# 書き込み先と解決順の理由は toggle-auto-commit と同じ。
#
# 既存の設定を壊さないよう jq でキー単位の書き換えのみを行い、書き込みは一時ファイル
# 経由にして失敗時に元ファイルを残す。

set -euo pipefail

KEY=AGENT_AUTO_PUSH
STATE_BASENAME=claude-env.json

usage() {
  cat <<'EOF'
toggle-auto-push - Claude Code の push の確認省略（AGENT_AUTO_PUSH）を切り替える

Usage:
  toggle-auto-push           # 現在の状態を見てトグル
  toggle-auto-push on        # 有効化（enable / 1 も可）
  toggle-auto-push off       # 無効化（disable / 0 も可）。git push は必ず確認を求める
  toggle-auto-push status    # 現在の状態を表示するだけ（ファイルは作らない）
  toggle-auto-push -h        # このヘルプ

有効なときに確認なしで通る push:
  単独の git push で、push する範囲が自分のコミットだけ、かつ PR に bot 以外の
  他者のレビューが無いもの。force（--force-with-lease を除く）などは有効でも確認する

対象ファイル:
  git ディレクトリ直下の claude-env.json
  （メイン作業ツリーは <repo>/.git、worktree は <repo>/.git/worktrees/<名前>）
  worktree ごとに別ファイルになるため、切り替えは他の worktree に波及しない
  git リポジトリ外ではカレントディレクトリ直下の .claude/settings.local.json
  settings.json やグローバル設定 (~/.claude) は触らない

現在値の解決順:
  claude-env.json -> リポジトリの .claude/settings.local.json -> 同 settings.json
  -> ~/.claude/settings.local.json -> ~/.claude/settings.json
  worktree で未指定なら共有側の値が既定として効く。off は "0" を書いて打ち消す。

反映タイミング:
  確認の hook が push のたびに読み直すので、実行中のセッションにもすぐ反映される。
EOF
}

[ "$#" -le 1 ] || {
  echo "引数が多すぎます: $*" >&2
  echo >&2
  usage >&2
  exit 2
}

case "${1-}" in
  '') action=toggle ;;
  on | enable | 1) action=add ;;
  off | disable | 0) action=remove ;;
  status) action=status ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "不明な引数: $1" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac

command -v jq >/dev/null 2>&1 || {
  echo "jq が必要です（未インストール）。中止します。" >&2
  exit 1
}

git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || root="$PWD"

if [ -n "$git_dir" ]; then
  target="$git_dir/$STATE_BASENAME"
else
  target="$root/.claude/settings.local.json"
fi

read_key() {
  local file="$1"
  [ -f "$file" ] || return 0
  jq -r --arg k "$KEY" '.env[$k] // empty' "$file" 2>/dev/null || {
    echo "$file を読めません（JSON が不正、または env がオブジェクトでない）。中止します。" >&2
    return 1
  }
}

sources=()
if [ -n "$git_dir" ]; then
  sources+=("$git_dir/$STATE_BASENAME")
fi
sources+=(
  "$root/.claude/settings.local.json"
  "$root/.claude/settings.json"
  "$HOME/.claude/settings.local.json"
  "$HOME/.claude/settings.json"
)

current=""
source_file=""
for file in "${sources[@]}"; do
  val="$(read_key "$file")"
  if [ -n "$val" ]; then
    current="$val"
    source_file="$file"
    break
  fi
done

state_label() {
  case "$1" in
    1) echo '有効 ("1")' ;;
    '') echo '無効 (未設定)' ;;
    *) echo "無効 (\"$1\")" ;;
  esac
}

echo "$target"
if [ -n "$source_file" ] && [ "$source_file" != "$target" ]; then
  echo "  現在値の採用元: $source_file"
fi

if [ "$action" = status ]; then
  echo "push の確認省略: $(state_label "$current")"
  exit 0
fi

if [ "$action" = toggle ]; then
  if [ "$current" = "1" ]; then action=remove; else action=add; fi
fi

if [ "$action" = add ]; then new=1; else new=0; fi

mkdir -p "$(dirname "$target")"
[ -f "$target" ] || echo '{}' >"$target"

mode="$(stat -f %Lp "$target" 2>/dev/null || stat -c %a "$target" 2>/dev/null || true)"

tmp="$(mktemp "$target.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

jq --arg k "$KEY" --arg v "$new" '.env[$k] = $v' "$target" >"$tmp"

[ -s "$tmp" ] || {
  echo "jq の出力が空でした。ファイルは変更していません。" >&2
  exit 1
}

if [ -n "$mode" ]; then
  chmod "$mode" "$tmp"
fi

mv "$tmp" "$target"
trap - EXIT

echo "push の確認省略: $(state_label "$current") -> $(state_label "$new")"
echo "（この worktree のみ。実行中の Claude Code セッションにもすぐ反映される）"
