{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "LANG": "en_US.UTF-8",
    "MAX_MCP_OUTPUT_TOKENS": "100000",
    "CLAUDE_CODE_THRIFTY_SONIC": "false",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
    "AGENT_AUTO_COMMIT": "1",
    "AGENT_AUTO_PUSH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue status *)",
      "Bash(gh repo view *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh search *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git branch -a*)",
      "Bash(git branch -r*)",
      "Bash(git branch -v*)",
      "Bash(git branch -l*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current*)",
      "Bash(git branch --merged*)",
      "Bash(git branch --no-merged*)",
      "Bash(git branch --contains*)",
      "Bash(git branch --sort*)",
      "Bash(git branch --format*)",
      "Bash(git stash list *)",
      "Bash(git blame *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(terraform validate *)",
      "mcp__ccd_directory__change_directory"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env_local)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(~/.config/dev-secrets/**)",
      "Edit(~/.config/dev-secrets/**)",
      "Bash(*dev-secrets*)",
      "Bash(*PLAYWRIGHT_MCP_SECRETS_FILE*)",
      "Bash(playwright-cli *cookie-get*)",
      "Bash(playwright-cli *cookie-list*)",
      "Bash(playwright-cli *localstorage-get*)",
      "Bash(playwright-cli *localstorage-list*)",
      "Bash(playwright-cli *sessionstorage-get*)",
      "Bash(playwright-cli *sessionstorage-list*)",
      "Bash(playwright-cli *state-save*)",
      "Bash(playwright-cli *request *)",
      "Bash(playwright-cli *request-headers*)",
      "Bash(playwright-cli *response-headers*)",
      "Bash(playwright-cli *request-body*)",
      "Bash(playwright-cli *response-body*)",
      "Bash(playwright-cli *run-code*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/confirm-remote-commands.sh",
            "timeout": 30,
            "statusMessage": "Checking for remote-impacting commands..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/zsh-modifier-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-commit-state.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/japanese-output-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "1password@1password": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    },
    "1password": {
      "source": {
        "source": "github",
        "repo": "1Password/1password-claude-plugin"
      }
    }
  },
  "language": "japanese",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "switchModelsOnFlag": false,
  "sandbox": {
    "enabled": false
  }
}
