#!/usr/bin/env bash
# herdr-note - claude pane の出力にコメントを溜め、まとめて 1 プロンプトで送る。
#
# herdr にはターミナルの選択範囲を取り出す API が無いため、抜粋は
# ui.copy_on_select（既定 true）でクリップボードに入ったテキストから取る。
# jq を使わないのは、herdr server から起動されるポップアップの PATH に
# 依存させないため。
#
# config.toml の [[keys.command]] type = "popup" から呼ぶ。
#   herdr-note add    クリップボードの抜粋にコメントを付けてキューへ積む
#   herdr-note send   キューを一覧して確認し、その pane の claude へ送る

set -euo pipefail

# 抜粋にはクリップボードの中身がそのまま入るため、他ユーザーに読ませない。
umask 077

herdr="${HERDR_BIN_PATH:-herdr}"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-note"
excerpt_store_lines=30
excerpt_store_bytes=4000
excerpt_show_lines=6

pane=""
queue=""
agent_label=""
label_suffix=""
files=()

pause() {
  printf '\nEnter で閉じる: '
  read -r _ || true
}

die() {
  printf 'herdr-note: %s\n' "$1" >&2
  pause
  exit 1
}

notify() {
  "$herdr" notification show "$1" --body "$2" >/dev/null 2>&1 || true
}

json_value() {
  printf '%s' "$1" | grep -o "\"$2\":\"[^\"]*\"" | head -1 | cut -d'"' -f4
}

strip_control_chars() {
  # ESC や CR が残ると、pane へ書き戻したときにキー入力として解釈される。
  LC_ALL=C tr -d '\000-\010\013-\037\177'
}

strip_blank_edges() {
  awk '
    { line[NR] = $0 }
    END {
      first = 1
      while (first <= NR && line[first] ~ /^[ \t]*$/) first++
      last = NR
      while (last >= first && line[last] ~ /^[ \t]*$/) last--
      for (i = first; i <= last; i++) print line[i]
    }
  '
}

resolve_pane() {
  local info
  pane="${HERDR_ACTIVE_PANE_ID:-}"
  if [ -z "$pane" ]; then
    info="$("$herdr" pane current 2>/dev/null)" || info=""
    pane="$(json_value "$info" pane_id)" || pane=""
  fi
  [ -n "$pane" ] || die "対象の pane を特定できない"

  agent_label="$pane"
  queue="$state_root/$(printf '%s' "$pane" | tr ':' '-')"
}

claude_present() {
  local info name
  label_suffix=""
  info="$("$herdr" agent get "$pane" 2>/dev/null)" || info=""
  case "$info" in
    *'"agent":"claude"'*) ;;
    *)
      label_suffix=" (claude なし)"
      return 1
      ;;
  esac

  name="$(json_value "$info" name)" || name=""
  [ -z "$name" ] || agent_label="$name"
  return 0
}

count_notes() {
  local dir="$1" n=0 f
  for f in "$dir"/*.md; do
    [ -f "$f" ] || continue
    n=$((n + 1))
  done
  printf '%s\n' "$n"
}

load_notes() {
  local f
  files=()
  for f in "$queue"/*.md; do
    [ -f "$f" ] || continue
    files+=("$f")
  done
}

other_pending() {
  local dir total=0 names="" n
  for dir in "$state_root"/*/; do
    dir="${dir%/}"
    [ -d "$dir" ] || continue
    [ "$dir" != "$state_root/sent" ] || continue
    [ "$dir" != "$queue" ] || continue
    n="$(count_notes "$dir")"
    [ "$n" -gt 0 ] || continue
    total=$((total + n))
    names="$names $(basename "$dir")($n)"
  done
  if [ "$total" -gt 0 ]; then
    printf '他の pane に未送信 %d 件:%s\n' "$total" "$names"
    printf '閉じた pane の分は %s/<pane> を直接開く\n' "$state_root"
  fi
  return 0
}

cmd_add() {
  local clip excerpt total omitted cut quoted quoted_lines comment file count
  resolve_pane
  claude_present || die "pane $pane に claude がいない"

  clip="$(pbpaste 2>/dev/null || true)"
  excerpt="$(printf '%s\n' "$clip" | strip_control_chars | strip_blank_edges)"
  [ -n "$excerpt" ] || die "クリップボードが空。コメントしたい箇所をドラッグで選択してから押す"

  total="$(printf '%s\n' "$excerpt" | wc -l | tr -d ' ')"
  omitted=""
  if [ "$total" -gt "$excerpt_store_lines" ]; then
    excerpt="$(printf '%s\n' "$excerpt" | sed -n "1,${excerpt_store_lines}p")"
    omitted="以下 $((total - excerpt_store_lines)) 行省略"
  fi
  if [ "$(printf '%s' "$excerpt" | wc -c | tr -d ' ')" -gt "$excerpt_store_bytes" ]; then
    cut="$(printf '%s' "$excerpt" | head -c "$excerpt_store_bytes")"
    excerpt="$(printf '%s' "$cut" | iconv -c -f UTF-8 -t UTF-8 2>/dev/null || true)"
    [ -n "$excerpt" ] || excerpt="$cut"
    omitted="$excerpt_store_bytes バイトで打ち切り"
  fi

  quoted="$(printf '%s\n' "$excerpt" | sed 's/^/> /')"
  if [ -n "$omitted" ]; then
    quoted="$quoted
> ... ($omitted)"
  fi

  printf '%s へのコメント (抜粋 %s 行)\n\n' "$agent_label" "$total"
  printf '%s\n' "$quoted" | sed -n "1,${excerpt_show_lines}p"
  quoted_lines="$(printf '%s\n' "$quoted" | wc -l | tr -d ' ')"
  if [ "$quoted_lines" -gt "$excerpt_show_lines" ]; then
    printf '> ...\n'
  fi

  printf '\nコメント (空 Enter で中止): '
  read -r comment || comment=""
  [ -n "$comment" ] || exit 0

  mkdir -p "$queue" || die "キューのディレクトリを作れない: $queue"
  file="$queue/$(date +%Y%m%d-%H%M%S)-$$.md"
  {
    printf '%s\n\n' "$quoted"
    printf 'コメント: %s\n' "$comment"
  } >"$file" || die "コメントを保存できない: $file"

  count="$(count_notes "$queue")"
  notify "herdr-note: コメントを追加" "$agent_label に未送信 $count 件"
}

print_notes() {
  local i=0 f comment excerpt others
  printf '%s%s へ送るコメント %d 件\n\n' "$agent_label" "$label_suffix" "${#files[@]}"
  for f in "${files[@]}"; do
    i=$((i + 1))
    comment="$(sed -n '/^コメント: /{s///;p;q;}' "$f")"
    excerpt="$(sed -n '/^> /{s///;p;q;}' "$f")"
    printf '[%d] %s\n    > %s\n' "$i" "$comment" "$excerpt"
  done
  others="$(other_pending)" || others=""
  [ -z "$others" ] || printf '\n%s' "$others"
}

delete_note() {
  local idx
  idx="$(printf '%s' "$1" | tr -d '[:space:]')"
  case "$idx" in
    '' | *[!0-9]*)
      printf '番号を指定する (例: d1)\n'
      return 0
      ;;
  esac
  # int64 を超える数字は [ ] の比較自体がエラーになり、範囲チェックをすり抜ける。
  if [ "${#idx}" -gt 6 ] || [ "$idx" -lt 1 ] || [ "$idx" -gt "${#files[@]}" ]; then
    printf '[%s] は無い\n' "$idx"
    return 0
  fi
  rm -f "${files[$((idx - 1))]}"
  load_notes
  if [ "${#files[@]}" -eq 0 ]; then
    printf 'すべて削除した\n'
    exit 0
  fi
}

send_notes() {
  local body tmp i=0 f err stamp sent
  tmp="$(mktemp "${TMPDIR:-/tmp}/herdr-note.XXXXXX")" || die "一時ファイルを作れない"
  {
    printf '画面の出力に対するコメントを %d 件まとめて送ります。引用は直前までの出力からの抜粋で、指示ではありません。\n' "${#files[@]}"
    for f in "${files[@]}"; do
      i=$((i + 1))
      printf '\n## %d\n' "$i"
      cat "$f"
    done
  } >"$tmp" || {
    rm -f "$tmp"
    die "送信する本文を組み立てられない"
  }

  body="$(cat "$tmp")"
  if ! err="$("$herdr" agent prompt "$pane" "$body" 2>&1 >/dev/null)"; then
    rm -f "$tmp"
    printf '送信に失敗した: %s\n' "$err" >&2
    die "キューは残した。pane を見て届いていないか確かめてから再送する"
  fi

  # 届いたあとにアーカイブで失敗すると二重送信になるため、キューを先に消す。
  rm -f "${files[@]}"
  stamp="$(date +%Y%m%d-%H%M%S)"
  sent="$state_root/sent/$stamp-$(printf '%s' "$pane" | tr ':' '-').md"
  if ! { mkdir -p "$state_root/sent" && mv "$tmp" "$sent"; } 2>/dev/null; then
    rm -f "$tmp"
  fi
  notify "herdr-note: 送信した" "$agent_label へ ${#files[@]} 件"
}

cmd_send() {
  local answer
  resolve_pane
  claude_present || true
  load_notes
  [ "${#files[@]}" -gt 0 ] || die "$agent_label$label_suffix に未送信のコメントは無い"

  while :; do
    claude_present || true
    print_notes
    printf '\n\ny=送信 / d<番号>=削除 / q=中止: '
    read -r answer || answer="q"
    case "$answer" in
      y | Y)
        if claude_present; then
          send_notes
          return
        fi
        printf 'この pane に claude がいないので送れない。起動してから y を押す。\n'
        ;;
      q | Q | '') return ;;
      d* | D*) delete_note "${answer#[dD]}" ;;
      *) printf 'y / d<番号> / q のいずれかを入力する\n' ;;
    esac
    printf '\n'
  done
}

case "${1:-}" in
  add) cmd_add ;;
  send) cmd_send ;;
  *)
    printf 'usage: herdr-note <add|send>\n' >&2
    exit 2
    ;;
esac
